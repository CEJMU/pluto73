diff --git a/board/pluto/post-build.sh b/board/pluto/post-build.sh
index 03021a4918..9878d8bd92 100755
--- a/board/pluto/post-build.sh
+++ b/board/pluto/post-build.sh
@@ -91,3 +91,32 @@ ln -sf ../../wpa_supplicant/ifupdown.sh ${TARGET_DIR}/etc/network/if-pre-up.d/wp
 ln -sf ../../wpa_supplicant/ifupdown.sh ${TARGET_DIR}/etc/network/if-post-down.d/wpasupplicant
 
 ln -sf device_reboot ${TARGET_DIR}/usr/sbin/pluto_reboot
+
+# ---------------------------------------------------------------------------
+# Custom Pluto SSB transceiver app  --  baked into /opt/pluto when it has been
+# cross-compiled (top-level `make bake` / `make all`). Guarded on the binary
+# existing so a plain `make firmware` (no app built yet) still succeeds.
+# BOARD_DIR = <repo>/plutoplus/plutosdr-fw/buildroot/board/pluto -> repo is 5 up.
+# ---------------------------------------------------------------------------
+REPO_ROOT="$(cd ${BOARD_DIR}/../../../../.. && pwd)"
+APP_BIN="${REPO_ROOT}/target/armv7-unknown-linux-gnueabihf/release/pluto"
+if [ -x "${APP_BIN}" ]; then
+	${INSTALL} -D -m 0755 ${APP_BIN} ${TARGET_DIR}/opt/pluto/pluto
+	mkdir -p ${TARGET_DIR}/opt/pluto/static
+	cp -a ${REPO_ROOT}/static/. ${TARGET_DIR}/opt/pluto/static/
+	# TLS certs: bake them in if present (from `make certs` or user-supplied); the app
+	# falls back to HTTP-only when absent.
+	[ -f ${REPO_ROOT}/cert.pem ] && ${INSTALL} -D -m 0644 ${REPO_ROOT}/cert.pem ${TARGET_DIR}/opt/pluto/cert.pem
+	[ -f ${REPO_ROOT}/key.pem ]  && ${INSTALL} -D -m 0600 ${REPO_ROOT}/key.pem  ${TARGET_DIR}/opt/pluto/key.pem
+	# Autostart on boot; cd into /opt/pluto so cert.pem/key.pem and static/ resolve.
+	cat > ${TARGET_DIR}/etc/init.d/S99pluto <<'PLUTOEOF'
+#!/bin/sh
+case "$1" in
+  start) cd /opt/pluto && ./pluto >/var/log/pluto.log 2>&1 & ;;
+  stop)  killall pluto 2>/dev/null ;;
+  restart) "$0" stop; "$0" start ;;
+  *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
+esac
+PLUTOEOF
+	chmod 0755 ${TARGET_DIR}/etc/init.d/S99pluto
+fi
